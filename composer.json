{
  "name": "hercilioln/simple-upload",
  "description": "A simple and robust file upload manager for Laravel (Supports Local & S3).",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Hercilio Lopes"
    }
  ],
  "require": {
    "php": "^8.0",
    "illuminate/http": "^9.0|^10.0|^11.0|^12",
    "illuminate/support": "^9.0|^10.0|^11.0|^12"
  },
  "autoload": {
    "psr-4": {
      "Hercilio\\SimpleUpload\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Hercilio\\SimpleUpload\\SimpleUploadServiceProvider"
      ],
      "aliases": {
        "SimpleUpload": "Hercilio\\SimpleUpload\\Facades\\SimpleUpload"
      }
    }
  }
}